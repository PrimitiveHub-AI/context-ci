# PrimitiveHub — root compose env template.
# Copy to .env (gitignored) and fill in. Compose reads .env automatically for
# ${VAR} substitution across compose.yaml / compose.prod.yaml.

# ─── Core (see compose.yaml for the full set + inline defaults) ─────────────
# POSTGRES_PASSWORD=change-me
# WEB_PORT=3000
# API_PORT=8000
# AUTHENTIK_PORT=9000

# ─── Self-hosted Umami analytics (ADR-0046) ────────────────────────────────
# PUBLIC, non-secret constants — baked into the web image at BUILD time
# (NEXT_PUBLIC_* is inlined; the root layout is SSG'd so runtime env can't
# reach it). Empty → the site loads no analytics script (no beacon). Get the
# website id by creating a website in the Umami dashboard
# (http://127.0.0.1:${UMAMI_PORT:-3001}). For the CI-built launch image, set
# these two as GitHub repo *variables* (not secrets) so build-web.yml bakes
# them:  gh variable set NEXT_PUBLIC_UMAMI_SRC ; gh variable set NEXT_PUBLIC_UMAMI_WEBSITE_ID
NEXT_PUBLIC_UMAMI_SRC=https://analytics.primitivehub.ai
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Umami server-side secret (JWT + share-token salt). Generate: openssl rand -hex 32
UMAMI_APP_SECRET=
# Local admin dashboard host port (bound to 127.0.0.1 only; host nginx proxies
# analytics.primitivehub.ai to it). Public exposure = host nginx vhost
# (deploy/nginx/analytics.primitivehub.ai.conf) fronted by Cloudflare proxied
# DNS → the server's public IP. No Caddy, no tunnel.
UMAMI_PORT=3001
