# PrimitiveHub API — environment variables.
# Copy to .env (gitignored) and adjust for local dev.

# Django
DJANGO_SECRET_KEY=replace-me-for-real-deployment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://primitivehub:primitivehub@postgres:5432/primitivehub

# Cache (Valkey, redis-protocol-compatible)
VALKEY_URL=redis://valkey:6379/0

# OIDC / Authentik
OIDC_ISSUER=http://authentik-server:9000/application/o/primitivehub/
OIDC_AUDIENCE=primitivehub-api
OIDC_VERIFY_AUDIENCE=True

# Local dev — set DEV_AUTH_BYPASS=True to skip Authentik entirely; the API
# pretends every request is authenticated as DEV_OIDC_SUBJECT. NEVER set in
# production: the settings module refuses to start with this on when DEBUG=False.
DEV_AUTH_BYPASS=True
DEV_OIDC_SUBJECT=dev-mhm@cyberorca.sa
DEV_OIDC_EMAIL=dev_mh@protonmail.com
DEV_OIDC_NAME=M.H. (dev)

# Object storage (S3-compatible — R2 in prod, MinIO option for self-host).
# Create a bucket-scoped R2 token at Cloudflare → R2 → API Tokens with
# Object Read & Write on the dev bucket only.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<paste-here>
S3_SECRET_ACCESS_KEY=<paste-here>
S3_BUCKET=primitivehub-primitives-dev
S3_REGION=auto

# Maximum upload size in bytes for /api/v1/primitives/{slug}/versions
# (rejects oversized requests early, before reading the body). Default 1 MiB.
PRIMITIVE_MAX_BYTES=1048576
