# Keep build context lean and avoid leaking secrets into images.

# Version control
.git
.github
.gitattributes
.gitignore

# Docker itself (not needed inside the image)
.dockerignore
Dockerfile
compose.yaml
compose.override.yaml
compose.prod.yaml

# Build output — rebuilt inside the container
.next
.turbo
out
build
dist

# Dependencies — reinstalled inside the container
node_modules
.pnpm-store

# TypeScript cache
*.tsbuildinfo

# Env files — never bake secrets into images; inject at runtime
.env
.env.local
.env.*.local
.env.development
.env.production

# Logs
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor noise
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.swo
*~

# Personal / per-developer
.claude

# Dev-only files not needed in the production image.
# NOTE: docs/ is deliberately NOT excluded. The /docs, /decisions, and
# /specs routes read from repo-root docs/ via findDocsRoot(); it is staged
# into this context by .github/workflows/build-web.yml and baked into the
# runner image. Excluding it here 404s all ~65 of those pages in prod
# (the dev container masked this via a runtime ./docs mount).
README.md
LICENSE
scripts/
