# PrimitiveHub web — environment variables.
# Copy to .env.local (gitignored) and adjust as needed.
# Nothing here is required yet; backend wiring in Phase 3 will add real entries.

# Override the host port the web container binds to (default 3000)
# WEB_PORT=3000

# Override the image tag used in production (default: latest)
# WEB_IMAGE=ghcr.io/devxyzx/primitivehub-web:sha-abc1234
