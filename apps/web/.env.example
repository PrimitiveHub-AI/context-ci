# PrimitiveHub web — environment variables.
# Copy to .env (gitignored) and adjust for local dev.

# Override the host port the web container binds to (default 3000)
# WEB_PORT=3000

# Override the image tag used in production (default: latest)
# WEB_IMAGE=ghcr.io/devxyzx/primitivehub-web:sha-abc1234

# ─── OIDC / Authentik (required for sign-in) ───────────────────────────────
# Set these after provisioning the OIDC application in Authentik admin.
# See apps/web/README.md "Authentik OIDC setup" for the exact steps.
OIDC_ISSUER_URL=http://localhost:9000/application/o/primitivehub/
OIDC_CLIENT_ID=<your-client-id-from-authentik>
OIDC_CLIENT_SECRET=<your-client-secret-from-authentik>
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
OIDC_SCOPES=openid profile email

# Server-side proxy target for /api/v1/* requests. The compose dev overlay
# already sets this to http://api:8000/api/v1 so the Next.js route handler
# can reach the Django container by service name. In production this
# points at the internal api hostname.
# DJANGO_API_BASE_URL=http://api:8000/api/v1
